{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ykcbbgobiasgvuzwadaz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "assistentezero",
      "version": "0.1.0",
      "title": "Assistentezero"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List the signed-in user's open Zero tasks and appointments, soonest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "include_done": {
              "type": "boolean",
              "description": "Also include completed tasks."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_task",
        "title": "Add task",
        "description": "Create a task or appointment in the signed-in user's Zero agenda.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Task title."
            },
            "due_at": {
              "type": "string",
              "format": "date-time",
              "description": "Optional start time, ISO 8601 with timezone."
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "description": "Optional duration in minutes."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Priority, default medium."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's recent income and expenses in Zero, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 366,
              "description": "How many past days to include, default 30."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_transaction",
        "title": "Add transaction",
        "description": "Record an expense or income in the signed-in user's Zero finances; the category is chosen automatically when omitted.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "expense",
                "income"
              ],
              "description": "expense or income."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000000,
              "description": "Amount in the user's currency."
            },
            "description": {
              "type": "string",
              "maxLength": 200,
              "description": "What it was, e.g. 'mercado'."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Optional category; automatic when omitted."
            },
            "occurred_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date YYYY-MM-DD, default today."
            }
          },
          "required": [
            "kind",
            "amount"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_meals",
        "title": "List meals",
        "description": "List the meals and macros the signed-in user logged in Zero on a given day.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date YYYY-MM-DD, default today (UTC)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "time_summary",
        "title": "Time summary",
        "description": "Show how the signed-in user's logged time was split across activities on a given day, in hours and percent.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date YYYY-MM-DD, default today (UTC)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
